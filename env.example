# Copy this file to .env for local development (npm run dev).
# On Netlify itself, set these as Site settings → Environment variables instead —
# never commit a real .env file.

# Client-side (Vite exposes anything prefixed VITE_ to the browser bundle —
# the Supabase anon key is DESIGNED to be public; row-level security in
# supabase/schema.sql is what actually protects the data, not key secrecy).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side ONLY, and OPTIONAL — the app doesn't call this by default (the
# chatbot is rule-based and free; see CHAT_TOPICS in src/App.jsx). Only needed
# if you re-enable the real-AI chatbot via netlify/functions/chat.js — see
# README.md. Set in Netlify's environment variables, never with a VITE_
# prefix (that would ship it to every browser).
ANTHROPIC_API_KEY=your-anthropic-api-key
